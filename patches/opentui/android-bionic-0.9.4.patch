diff -ruN a/packages/native/src/android-untag.c b/packages/native/src/android-untag.c
--- a/packages/native/src/android-untag.c	1970-01-01 05:30:00.000000000 +0530
+++ b/packages/native/src/android-untag.c	2026-11-24 11:49:02.826678749 +0530
@@ -0,0 +1,23 @@
+/* android-untag.c - disable Android heap pointer tagging for this process.
+ *
+ * Android 12+ scudo may return TBI-tagged heap pointers (top byte set, e.g.
+ * 0xb4...). Native code tolerates them (top-byte-ignore), but OpenTUI hands
+ * pointers to JavaScript, which stores them as doubles/BigInt and rejects
+ * anything above Number.MAX_SAFE_INTEGER
+ * ("Pointer exceeds safe integer range"). Disabling tagging makes scudo
+ * return canonical addresses again. Tag checks on already-tagged live
+ * allocations are unaffected; tagging cannot be re-enabled, which is fine
+ * for a TUI process.
+ *
+ * mallopt(M_BIONIC_SET_HEAP_TAGGING_LEVEL, ...) is API 31+; on older
+ * releases the option is unknown and mallopt() returns 0 harmlessly.
+ */
+#include <stdint.h>
+
+extern int mallopt(int option, int value);
+#define M_BIONIC_SET_HEAP_TAGGING_LEVEL (-204)
+#define M_HEAP_TAGGING_LEVEL_NONE 0
+
+__attribute__((constructor)) static void opentui_disable_heap_tagging(void) {
+    (void)mallopt(M_BIONIC_SET_HEAP_TAGGING_LEVEL, M_HEAP_TAGGING_LEVEL_NONE);
+}
